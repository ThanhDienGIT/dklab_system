# Postgres (Vercel: dùng Neon qua Vercel Marketplace, biến này được tự gán)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dklab

# Bí mật ký JWT + mã hóa cấu hình nhạy cảm (>= 32 ký tự). Tạo: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Tenant mặc định khi truy cập bằng domain chưa được gán (vd: *.vercel.app)
DEFAULT_TENANT=dulich_demo

# Domain gốc của nền tảng: <slug>.ROOT_DOMAIN sẽ map về tenant <slug>
ROOT_DOMAIN=dklab.vn

# Mật khẩu ban đầu cho tài khoản demo khi seed
SEED_ADMIN_PASSWORD=Admin@123
