# ═══ Cấu hình Docker — copy thành .env.docker rồi sửa ═══
# Bắt buộc: chuỗi ngẫu nhiên ≥ 32 ký tự (openssl rand -base64 48). Giữ nguyên khi chuyển server.
APP_SECRET=
# Domain gốc: <slug>.ROOT_DOMAIN tự map về doanh nghiệp <slug>
ROOT_DOMAIN=dklab.vn

# Mật khẩu database trong docker-compose (đổi khi chạy thật)
POSTGRES_PASSWORD=dklab

# Super Admin /superdklab (chỉ dùng lần tạo đầu tiên — đổi mật khẩu ngay sau khi đăng nhập)
PLATFORM_ADMIN_USER=dklab
PLATFORM_ADMIN_PASSWORD=Dklab@123

# ─── CHỌN KIỂU TRIỂN KHAI ───────────────────────────────────────────────
# (A) Website demo: dữ liệu mẫu + hiện tài khoản mẫu ở /login
SEED=1
DEMO_MODE=1
# PLUGINS=spa                 # chỉ ngành spa (build lại: docker compose up -d --build)
# DEFAULT_TENANT=spa_demo     # doanh nghiệp hiện ở http://localhost:3000

# (B) Khách thật 1 ngành: đặt SEED=0, DEMO_MODE=0 ở trên rồi bỏ comment khối dưới
# TENANT_SLUG=spa_hoasen
# TENANT_NAME=Spa Hoa Sen
# TENANT_INDUSTRY=spa         # travel | spa | cafe | restaurant | hotel | accounting | <plugin tự thêm>
# TENANT_PLAN=pro             # basic | pro | enterprise
# TENANT_DOMAINS=spahoasen.vn,www.spahoasen.vn
# OWNER_NAME=Nguyễn Thị Hoa
# OWNER_EMAIL=chu@spahoasen.vn
# OWNER_PASSWORD=DoiMatKhau123
# OWNER_PHONE=0901234567
# TENANT_ADDRESS=12 Lê Lợi, Q.1, TP.HCM

# Mật khẩu tài khoản demo khi seed
SEED_ADMIN_PASSWORD=Admin@123

# Tài khoản nhận tiền bán gói / plugin (VietQR ở Cửa hàng)
PLATFORM_BANK_BIN=970436
PLATFORM_BANK_ACCOUNT=0123456789
PLATFORM_BANK_NAME=CONG TY DKLAB

# Chỉ khi thử qua http://<IP> trong mạng LAN (không có HTTPS). Chạy thật qua domain + HTTPS thì XÓA dòng này.
# COOKIE_SECURE=0
